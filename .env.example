# Copy this file to .env and fill in the values for the provider you run with.
# .env is in .gitignore, so real keys never get committed. Values left empty are simply unused.
# Only `timefence run --method agent` needs them; the baselines and the offline demo do not.
# --provider claude (the default)
ANTHROPIC_API_KEY=
# --provider k2: K2 Horizon, by default through IFM's API at https://api.ifm.ai/v1
K2_API_KEY=
# Only for another host: its address, and its name for the model if not IFM/K2-Horizon-375B-A23B
K2_BASE_URL=
K2_MODEL=
# --provider deepseek
DEEPSEEK_API_KEY=
