# Copy this file to .env and fill in the values for the provider you run with.
# .env is in .gitignore, so real keys never get committed. Values left empty are simply unused.
# Only `timefence run --method agent` needs them; the baselines and the offline demo do not.
# --provider k2 (the default): K2 Horizon, with the key and address from your API access
K2_API_KEY=
K2_BASE_URL=
# Only if your API names the model differently (default IFM/K2-Horizon-375B-A23B)
K2_MODEL=
# --provider claude
ANTHROPIC_API_KEY=
# --provider deepseek
DEEPSEEK_API_KEY=
